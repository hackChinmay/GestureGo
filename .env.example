# Supabase Database & Storage Configuration (graVITas '26 Festival Data)
# Obtain these from your Supabase Project Settings -> API
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-public-key"

# Storage Bucket: gravitas-event-photos
# Optional: Service Role Key for server-side administrative migration scripts
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# GEMINI_API_KEY: Optional for Gemini AI multimodal integration
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Local or production hosting endpoint
APP_URL="http://localhost:3000"
